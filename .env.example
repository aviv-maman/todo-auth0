UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

AUTH0_SECRET=replace-with-your-own-secret-generated-with-openssl-or-use-https://generate-secret.vercel.app/32
# AUTH0_BASE_URL is configured in next.config.js
AUTH0_ISSUER_BASE_URL=YOUR_ISSUER_BASE_URL
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email
AUTH0_ADMIN_EMAIL=THE_EMAIL_OF_THE_ADMIN_(AFTER_SIGNIN_WITH_AUTH0)